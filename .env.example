# ---------- Core ----------
# Neon connection string (pooled). Locally any Postgres works.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/arthqc?sslmode=require
# 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app (used for auth, invitation links and emails)
APP_URL=https://your-app.vercel.app

# ---------- AI (Google Gemini Developer API) ----------
AI_PROVIDER=gemini            # "mock" = offline deterministic provider for local dev/tests only
GEMINI_API_KEY=
GEMINI_MODEL_EXTRACTION=gemini-2.5-flash
GEMINI_MODEL_EVALUATION=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite

# ---------- Storage (Cloudflare R2, private bucket) ----------
STORAGE_DRIVER=r2             # "local" = .data/uploads, development only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=arth-qc-uploads

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM="Arth-QC <reports@yourdomain.com>"

# ---------- Workers / limits ----------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=
EVALUATION_BATCH_SIZE=3
BUDDY_HOURLY_LIMIT=30
BUDDY_DAILY_LIMIT=120
BUDDY_RETENTION_DAYS=30
UPLOAD_RETENTION_HOURS=24

# ---------- Demo seed (optional) ----------
DEMO_PARENT_EMAIL=priya.parent@example.com
DEMO_PARENT_PASSWORD=
DEMO_STUDENT_PIN=
